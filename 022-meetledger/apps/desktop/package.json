{
  "name": "meetledger-desktop",
  "productName": "MeetLedger Desktop",
  "version": "1.0.0",
  "private": true,
  "description": "MeetLedger desktop companion — system audio capture (mic L / system R) and on-device transcription",
  "author": "MeetLedger",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "icons": "node scripts/make-placeholder-icon.mjs",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --x64"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
