# ===== MeetLedger configuration (copy to .env). Never commit real values. =====
NODE_ENV=production
APP_ORIGIN=https://meetledger.example.com     # public URL (CSRF origin check, links)
COOKIE_SECURE=true                            # true behind HTTPS
TRUST_PROXY=true                              # behind a reverse proxy
# 32+ random chars:  openssl rand -base64 48
SESSION_SECRET=
# base64 of exactly 32 random bytes:  openssl rand -base64 32   (KEEP A SAFE COPY: needed to read stored media/backups)
MASTER_KEY=
DATABASE_URL=postgres://meetledger:CHANGE_ME@127.0.0.1:5432/meetledger
POSTGRES_SUPERUSER_PASSWORD=                  # docker compose only
APP_DB_PASSWORD=                              # docker compose only
STORAGE_DRIVER=local
STORAGE_DIR=/data/storage
TMP_DIR=/data/tmp
MAX_UPLOAD_MB=1024
ALLOW_SIGNUP=false                            # first user via /setup, others by invitation
SAMPLE_WORKSPACE=true                         # allow creating the fictional sample workspace

# ----- Transcription (default: local, audio never leaves this server) -----
LOCAL_ASR_MODEL_DIR=/models                   # scripts/download-models.sh
LOCAL_ASR_MODEL=sense-voice
CLOUD_TRANSCRIPTION_PROVIDER=none             # none | openai | deepgram  (also requires workspace opt-in)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
DEEPGRAM_API_KEY=

# ----- AI (default: local-rules, nothing sent outside) -----
AI_PROVIDER=local-rules                       # local-rules | ollama | openai | anthropic (cloud also requires workspace opt-in)
AI_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_PROVIDER=local-hash                 # local-hash | openai | ollama

# ----- Email (default: outbox = stored only, nothing sent) -----
EMAIL_DRIVER=outbox                           # outbox | smtp
SMTP_URL=
EMAIL_FROM=MeetLedger <no-reply@example.com>

# ----- Calendar connectors (optional; create OAuth clients yourself) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

LOG_LEVEL=info
RUN_WORKER=true
WORKER_CONCURRENCY=2
